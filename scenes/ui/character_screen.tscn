[ext_resource type="Script" path="res://scripts/ui/components/ui_separator.gd" id="3_sep"]

[node name="CharacterScreen" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.016, 0.012, 0.016, 0.72)

[node name="CenterContainer" type="CenterContainer" parent="Dim"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="Panel" parent="Dim/CenterContainer"]
custom_minimum_size = Vector2(940, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Dim/CenterContainer/Panel"]
layout_mode = 2
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Dim/CenterContainer/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="HeaderRow" type="HBoxContainer" parent="Dim/CenterContainer/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Dim/CenterContainer/Panel/Margin/VBoxContainer/HeaderRow"]
layout_mode = 2
